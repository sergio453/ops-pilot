{
  "name": "ops-pilot",
  "version": "1.0.0",
  "description": "Ops Pilot Node.js skeleton",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:env": "node --env-file=.env --import tsx src/index.ts",
    "dev:backend": "npm run dev:http",
    "dev:backend:env": "npm run dev:http:env",
    "dev:frontend": "npm --prefix web run dev",
    "dev:http": "tsx src/http/server.ts",
    "dev:http:env": "node --env-file=.env --import tsx src/http/server.ts",
    "arena": "tsx src/arena.ts",
    "arena:env": "node --env-file=.env --import tsx src/arena.ts",
    "mcp": "tsx src/mcp/server.ts",
    "seed:story": "tsx src/scripts/seed-story.ts",
    "bench": "tsx src/bench.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ops",
    "pilot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@langchain/core": "^0.3.68",
    "@langchain/langgraph": "^0.2.74",
    "@langchain/openai": "^0.5.16",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.1.0",
    "langsmith": "^0.10.5",
    "sequelize": "^6.37.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.0",
    "@types/sequelize": "^4.28.20",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
